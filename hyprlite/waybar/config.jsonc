{
   "position": "top",
   "margin-top": "18",
   "margin-bottom": "9",

  "modules-left": [
    "custom/arch",
    "clock"
  ],

  "modules-center": [
  "hyprland/workspaces"
],

  "modules-right":[
    "custom/audio",
    "network"
  ],


 "clock": {
   "format": "{:%H:%M}",
   "interval": 1,
   "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
     "format": {
       "today": "<span color='#ff0000'><b>{}</b></span>"
     }
   }
  },

  "hyprland/workspaces": {
	"format": "{name} {icon}",
	"format-icons": {
		"active": "",
		"default": ""
	},
	"persistent-workspaces": {
		"*": 5
  }
 },
 "network": {
    "interface": "enp10s0",
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "tooltip-format-ethernet": "{ifname}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "nm-sidebar --toggle"
},

  "custom/audio": {
    "format": "󰕾",
    "on-click": "~/.local/bin/audio-control",
    "tooltip": false
},

  "custom/arch": {
       "format": "",
       "tooltip": false,
       "on-click": "~/.config/hyprlite/scripts/cheatsheet"
  }
}

-- Bezier curves
hl.curve("almostLinear", { type = "bezier", points = { {0.5, 0.5}, {0.75, 1.0} } })

-- Animations
hl.animation({
    leaf = "workspaces",
    enabled = true,
    speed = 1.94,
    bezier = "almostLinear",
    style = "slide",
})
hl.animation({
    leaf = "workspacesIn",
    enabled = true,
    speed = 1.21,
    bezier = "almostLinear",
    style = "slide",
})
hl.animation({
    leaf = "workspacesOut",
    enabled = true,
    speed = 1.94,
    bezier = "almostLinear",
    style = "slide",
})

-- Keybinds
hl.unbind("SUPER + SHIFT + Up")
hl.bind("SUPER + SHIFT + Up", hl.dsp.window.swap({ direction = "up" }))
hl.unbind("SUPER + SHIFT + Down")
hl.bind("SUPER + SHIFT + Down", hl.dsp.window.swap({ direction = "down" }))
hl.unbind("SUPER + SHIFT + Right")
hl.bind("SUPER + SHIFT + Right", hl.dsp.window.swap({ direction = "right" }))
hl.unbind("SUPER + C")
hl.bind("SUPER + C", hl.dsp.window.close())
hl.unbind("SUPER + mouse:272")
hl.bind("SUPER + mouse:272", hl.dsp.window.drag(), {
    mouse = true,
})
hl.unbind("SUPER + mouse:273")
hl.bind("SUPER + mouse:273", hl.dsp.window.drag(), {
    mouse = true,
})
hl.unbind("SUPER + F")
hl.bind("SUPER + F", hl.dsp.window.fullscreen())
hl.unbind("SUPER + SHIFT + P")
hl.bind("SUPER + P", hl.dsp.exec_cmd("cliphist list | rofi -dmenu -p \"Clipboard\" | cliphist decode | wl-copy"))
hl.unbind("SUPER + V")
hl.bind("SUPER + V", hl.dsp.window.float({ action = "toggle" }))
hl.unbind("SUPER + R")
hl.bind("SUPER + R", hl.dsp.exec_cmd(""))
hl.unbind("SUPER + T")
hl.bind("SUPER + space", hl.dsp.exec_cmd("~.,config/rofi/launchers/type-2/launcher.sh"))
hl.unbind("SUPER + D")
hl.bind("SUPER + E", hl.dsp.exec_cmd("yazi"))
